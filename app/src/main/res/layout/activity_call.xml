<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_night_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/padding_screen">

    <TextView
        android:id="@+id/text_call_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:textColor="@color/warm_night_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="00:00"
        android:textColor="@color/warm_night_text_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/text_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/call_no_active"
        android:textColor="@color/warm_night_text_secondary"
        android:textSize="14sp" />

    <!-- TODO(WebRTC): remote + local video SurfaceViews go here. See CallActivity. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/call_mute" />

        <Button
            android:id="@+id/button_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/call_camera" />

        <Button
            android:id="@+id/button_speaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/call_speaker" />
    </LinearLayout>

    <Button
        android:id="@+id/button_end_call"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/error_red"
        android:text="@string/call_end"
        android:textColor="#FFFFFF" />
</LinearLayout>
