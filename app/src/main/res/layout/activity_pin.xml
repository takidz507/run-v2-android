<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    android:padding="@dimen/padding_screen">

    <TextView
        android:id="@+id/text_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="64dp"
        android:text="@string/pin_create_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/pin_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/layout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/dot_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="○" android:textColor="@color/amber" android:textSize="24sp" />
        <TextView android:id="@+id/dot_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="○" android:textColor="@color/amber" android:textSize="24sp" />
        <TextView android:id="@+id/dot_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="○" android:textColor="@color/amber" android:textSize="24sp" />
        <TextView android:id="@+id/dot_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="○" android:textColor="@color/amber" android:textSize="24sp" />
        <TextView android:id="@+id/dot_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="○" android:textColor="@color/amber" android:textSize="24sp" />
        <TextView android:id="@+id/dot_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="○" android:textColor="@color/amber" android:textSize="24sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:textColor="@color/error_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/pin_key_1" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="1" />
        <Button android:id="@+id/pin_key_2" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="2" />
        <Button android:id="@+id/pin_key_3" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="3" />
        <Button android:id="@+id/pin_key_4" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="4" />
        <Button android:id="@+id/pin_key_5" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="5" />
        <Button android:id="@+id/pin_key_6" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="6" />
        <Button android:id="@+id/pin_key_7" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="7" />
        <Button android:id="@+id/pin_key_8" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="8" />
        <Button android:id="@+id/pin_key_9" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="9" />
        <View android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" />
        <Button android:id="@+id/pin_key_0" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="0" />
        <Button android:id="@+id/pin_key_delete" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:text="⌫" />
    </GridLayout>
</LinearLayout>
